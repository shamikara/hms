# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres) ------------------------------------------
# Supabase gives you two connection strings. They are not interchangeable.
#
#   DATABASE_URL       the POOLED string (port 6543, "Transaction" mode).
#                      Use this for the running app: serverless functions open
#                      many short-lived connections and would exhaust a direct
#                      connection pool.
#                      Append ?pgbouncer=true&connection_limit=1
#
#   DIRECT_URL         the DIRECT string (port 5432). Needed for schema work
#                      (db push, prisma studio, psql) because pgBouncer in
#                      transaction mode cannot run DDL or prepared statements.
#
# Supabase Dashboard > Project Settings > Database > Connection string
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Supabase (storage / media) --------------------------------------------
# Dashboard > Project Settings > API
# The anon key is PUBLIC — it ships to the browser. It must never be the
# service role key.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# Server-only. Bypasses Row Level Security, so it must never be prefixed
# NEXT_PUBLIC_ and never reach the browser. Used for uploads from server
# actions.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Storage bucket holding driver photos, vehicle images and fleet documents.
SUPABASE_STORAGE_BUCKET="media"

# --- Sessions ---------------------------------------------------------------
# Signs the auth JWT. Rotate before launch and whenever it may have leaked;
# rotating invalidates every existing session.
# Generate: openssl rand -base64 48
SESSION_SECRET="CHANGE_ME"

# --- Email (Resend) ---------------------------------------------------------
# resend.com > API Keys. Sending domain must be verified first.
RESEND_API_KEY="re_..."
RESEND_FROM="Wildlily Safari Resort <reservations@wildlilysafariresort.com>"

# --- Site -------------------------------------------------------------------
# Canonical origin for metadata, canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL="https://www.wildlilysafariresort.com"

# --- Seeding (not needed at runtime) ---------------------------------------
# Consumed only by `npm run seed`. Supply on the command line instead of
# storing them here if you prefer.
# ADMIN_EMAIL="you@example.com"
# ADMIN_PASSWORD="at-least-twelve-characters"

# Copy to .env and fill in. Never commit .env.
#
# Only two variables are REQUIRED to run the app: DATABASE_URL and
# SESSION_SECRET. Everything else is marked OPTIONAL and is only needed once
# the feature that reads it exists. Nothing reads the Supabase API keys yet.
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres) — REQUIRED --------------------------------
# Dashboard > Project Settings > Database > Connection string.
# The direct string (port 5432) is fine and is the simplest thing that works.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# OPTIONAL — only if DATABASE_URL above is switched to the POOLED string
# (port 6543, plus ?pgbouncer=true&connection_limit=1). Worth doing only when
# concurrent load starts exhausting direct connections; pgBouncer in
# transaction mode cannot run DDL, so schema work then needs this direct URL.
# DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Supabase storage / media — OPTIONAL ------------------------------------
# Nothing reads these yet: @supabase/supabase-js is not installed and no code
# uploads anything. Needed only once media upload is built. Until then, image
# URL fields (SafariDriver.imageUrl, Vehicle.imageUrls, VehicleDocument.fileUrl)
# hold any external URL, including one pasted from the Supabase dashboard.
#
# Dashboard > Project Settings > API Keys.
# Supabase is retiring the legacy anon/service_role JWTs (the long "eyJ..."
# ones) in favour of publishable/secret keys. Prefer the new format.
# NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
#
# PUBLIC — ships to the browser. Must never hold a secret key.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
#
# SERVER ONLY — bypasses Row Level Security. Never prefix NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY="sb_secret_..."
#
# SUPABASE_STORAGE_BUCKET="media"

# --- Sessions — REQUIRED ----------------------------------------------------
# Signs the auth JWT, so a guessable value means forgeable sessions. Use random
# bytes, not a memorable phrase — length alone is not entropy. Rotating it
# invalidates every existing session.
# Generate: openssl rand -base64 48
SESSION_SECRET="CHANGE_ME"

# --- Email (Resend) — OPTIONAL ----------------------------------------------
# Nothing sends email yet. Needed once booking confirmations exist.
# The sending domain must be verified at resend.com first.
# RESEND_API_KEY="re_..."
# RESEND_FROM="Wildlily Safari Resort <reservations@wildlilysafariresort.com>"

# --- Site — OPTIONAL --------------------------------------------------------
# Canonical origin for metadata, canonical URLs and the sitemap. Falls back to
# https://www.wildlilysafariresort.com when unset, so only needed to point a
# preview or staging deploy at its own origin.
# NEXT_PUBLIC_SITE_URL="https://www.wildlilysafariresort.com"

# --- Seeding (not needed at runtime) ---------------------------------------
# Consumed only by `npm run seed`. Supply on the command line instead of
# storing them here if you prefer.
# ADMIN_EMAIL="you@example.com"
# ADMIN_PASSWORD="at-least-twelve-characters"

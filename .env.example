# Copy to .env and fill in. Never commit .env.
#
# Only two variables are REQUIRED to run the app: DATABASE_URL and
# SESSION_SECRET. Everything else is marked OPTIONAL and is only needed once
# the feature that reads it exists. Nothing reads the Supabase API keys yet.
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres) — REQUIRED --------------------------------
# Dashboard > Project Settings > Database > Connection string.
# The direct string (port 5432) is fine and is the simplest thing that works.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# OPTIONAL — only if DATABASE_URL above is switched to the POOLED string
# (port 6543, plus ?pgbouncer=true&connection_limit=1). Worth doing only when
# concurrent load starts exhausting direct connections; pgBouncer in
# transaction mode cannot run DDL, so schema work then needs this direct URL.
# DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Supabase Storage (photo uploads) — OPTIONAL ---------------------------
# Lets staff upload photos in Admin > Photos (homepage slideshow, Food page,
# room photos). Without these the site uses its built-in photos only.
#
# 1. Supabase dashboard > Storage > New bucket: name it "media", tick Public.
# 2. Project Settings > API Keys: copy the Project URL and a SECRET key.
# SUPABASE_URL="https://PROJECT_REF.supabase.co"
#
# SERVER ONLY — never prefix NEXT_PUBLIC_. Only the server uses it, to upload
# and delete files.
# SUPABASE_SECRET_KEY="sb_secret_..."
#
# Only if the bucket is not called "media":
# NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET="media"

# --- Sessions — REQUIRED ----------------------------------------------------
# Signs the auth JWT, so a guessable value means forgeable sessions. Use random
# bytes, not a memorable phrase — length alone is not entropy. Rotating it
# invalidates every existing session.
# Generate: openssl rand -base64 48
SESSION_SECRET="CHANGE_ME"

# --- Email (Resend) — OPTIONAL, but needed for booking alerts ---------------
# New booking requests email the reservations inbox (Admin > Site Settings >
# "Booking alerts to", or the public email) and send the guest a "request
# received" note. Without both values the booking still works; no email goes.
# The sending domain must be verified at resend.com first.
# RESEND_API_KEY="re_..."
# RESEND_FROM="Wildlily Safari Resort <reservations@wildlilysafariresort.com>"

# --- Site — OPTIONAL --------------------------------------------------------
# Canonical origin for metadata, canonical URLs and the sitemap. Falls back to
# https://www.wildlilysafariresort.com when unset, so only needed to point a
# preview or staging deploy at its own origin.
# NEXT_PUBLIC_SITE_URL="https://www.wildlilysafariresort.com"

# --- Seeding (not needed at runtime) ---------------------------------------
# Consumed only by `npm run seed`. Supply on the command line instead of
# storing them here if you prefer.
# ADMIN_EMAIL="you@example.com"
# ADMIN_PASSWORD="at-least-twelve-characters"

# --- Online payments (Payments.lk) — OPTIONAL --------------------------------
# Lets guests pay an advance or the full stay by card when they book. Off until
# both are set AND it is switched on in Admin > Site Settings > Online Payments.
# Merchant portal > Developers: use sk_test_... while testing, sk_live_... after.
# SERVER ONLY. Never prefix NEXT_PUBLIC_.
# PAYMENTS_LK_SECRET_KEY="sk_test_..."
# Add a webhook endpoint at https://<your site>/api/payments/payments-lk
# (events: payment.succeeded, payment.failed, checkout.expired,
# refund.succeeded, refund.failed, refund.canceled) and paste its secret here.
# PAYMENTS_LK_WEBHOOK_SECRET="whsec_..."
# Only for local testing against a mock server:
# PAYMENTS_LK_API_BASE="http://localhost:4010"

# Google Search Console ownership check (HTML tag method): only the content value.
# GOOGLE_SITE_VERIFICATION="abc123..."
